# Use a slim Rust image as base
FROM rust:1.75-slim-bookworm

# Install system dependencies
RUN apt-get update && apt-get install -y \
    python3 python3-pip python3-venv \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Set up python environment and install maturin
RUN pip3 install --break-system-packages maturin numpy pytest

# Set working directory
WORKDIR /app

# Copy the entire project
COPY . .

# Build in release mode
RUN maturin develop --release --features "python"

# Entrypoint script to run benchmarks
ENTRYPOINT ["python3"]
CMD ["python/benchmarks/benchmark_unfair_individual.py"]
